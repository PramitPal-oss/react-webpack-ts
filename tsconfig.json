{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["jest", "node"],

    "baseUrl": ".",
    "rootDir": "./src", // required for MF plugin

    "esModuleInterop": true
  },

  "include": ["src", "global.d.ts", "env.d.ts", "**/*.test.ts", "**/*.test.tsx"]
}
