{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["jest", "node", "webpack-env"],
    "baseUrl": ".",
    "paths": {
      "components/ui": ["@mf-types/components/ui"],
      "components/*": ["@mf-types/components/*"]
    },
    "typeRoots": ["./node_modules/@types", "./@types", "./@mf-types"]
  },
  "include": ["src", "global.d.ts", "env.d.ts", "**/*.test.ts", "**/*.test.tsx", "@mf-types"]
}
